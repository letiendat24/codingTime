{
  "name": "codesync",
  "private": true,
  "version": "0.1.0",
  "description": "Interactive programming learning platform monorepo.",
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "set -a; . ./.env; set +a; pnpm -r --parallel --if-present dev",
    "dev:frontend": "set -a; . ./.env; set +a; pnpm --filter @codesync/frontend dev",
    "dev:backend": "set -a; . ./.env; set +a; pnpm --filter @codesync/backend dev",
    "build": "pnpm -r --if-present build",
    "lint": "pnpm -r --if-present lint",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @codesync/backend db:generate",
    "db:migrate": "pnpm --filter @codesync/backend db:migrate:dev",
    "db:migrate:dev": "pnpm --filter @codesync/backend db:migrate:dev",
    "db:migrate:deploy": "pnpm --filter @codesync/backend db:migrate:deploy",
    "db:seed": "pnpm --filter @codesync/backend db:seed",
    "seed:demo": "pnpm --filter @codesync/backend seed:demo",
    "infra:up": "docker compose --env-file .env -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/docker/docker-compose.yml down",
    "infra:logs": "docker compose --env-file .env -f infra/docker/docker-compose.yml logs -f",
    "docker:prod:build": "COMPOSE_PARALLEL_LIMIT=1 docker compose --env-file .env.production -f infra/docker/docker-compose.prod.yml build",
    "docker:prod:config": "docker compose --env-file .env.production -f infra/docker/docker-compose.prod.yml config",
    "docker:prod:infra": "docker compose --env-file .env.production -f infra/docker/docker-compose.prod.yml up -d postgres redis rabbitmq minio",
    "docker:prod:up": "docker compose --env-file .env.production -f infra/docker/docker-compose.prod.yml up -d reverse-proxy frontend backend video-worker code-worker code-judge-worker project-grading-worker",
    "docker:prod:down": "docker compose --env-file .env.production -f infra/docker/docker-compose.prod.yml down",
    "docker:prod:logs": "docker compose --env-file .env.production -f infra/docker/docker-compose.prod.yml logs -f",
    "docker:prod:ps": "docker compose --env-file .env.production -f infra/docker/docker-compose.prod.yml ps",
    "docker:prod:migrate": "docker compose --env-file .env.production -f infra/docker/docker-compose.prod.yml run --rm backend-migrate",
    "docker:deploy:config": "docker compose --env-file .env.production -f infra/docker/docker-compose.deploy.yml config",
    "docker:deploy:pull": "docker compose --env-file .env.production -f infra/docker/docker-compose.deploy.yml pull",
    "docker:deploy:up": "docker compose --env-file .env.production -f infra/docker/docker-compose.deploy.yml up -d",
    "docker:deploy:down": "docker compose --env-file .env.production -f infra/docker/docker-compose.deploy.yml down",
    "docker:deploy:logs": "docker compose --env-file .env.production -f infra/docker/docker-compose.deploy.yml logs -f",
    "docker:deploy:ps": "docker compose --env-file .env.production -f infra/docker/docker-compose.deploy.yml ps",
    "docker:deploy:migrate": "docker compose --env-file .env.production -f infra/docker/docker-compose.deploy.yml run --rm backend-migrate"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@next/eslint-plugin-next": "^15.1.4",
    "eslint-config-next": "^15.1.4",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
