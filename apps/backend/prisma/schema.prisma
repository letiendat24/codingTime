  @@index([jobId])
  @@unique([jobId, errorCode])
  @@map("video_processing_failures")
}

model AdminAuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  adminUserId  String   @db.Uuid
  action       String
  targetType   String
  targetId     String
  metadataJson Json?
  createdAt    DateTime @default(now())

  adminUser User @relation("AdminAuditActor", fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([adminUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

model Notification {
  id         String               @id @default(uuid()) @db.Uuid
  userId     String               @db.Uuid
  type       NotificationType
  category   NotificationCategory
  title      String
  message    String
  dataJson   Json?
  actionUrl  String?
  dedupeKey  String?              @unique
  readAt     DateTime?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
  @@index([userId, category, createdAt])
  @@index([category])
  @@map("notifications")
}

model NotificationPreference {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @unique @db.Uuid
  learningEnabled Boolean  @default(true)
  practiceEnabled Boolean  @default(true)
  projectEnabled  Boolean  @default(true)
  courseEnabled   Boolean  @default(true)
  systemEnabled   Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}
