  videoAssetId      String                @db.Uuid
  quality           String
  width             Int
  height            Int
  bitrate           Int
  playlistObjectKey String
  createdAt         DateTime              @default(now())

  videoAsset VideoAsset @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)

  @@unique([videoAssetId, quality])
  @@index([videoAssetId])
  @@map("video_renditions")
}

model VideoProcessingFailure {
  id               String   @id @default(uuid()) @db.Uuid
  videoAssetId     String   @db.Uuid
  jobId            String
  errorCode        String
  errorMessage     String
  retryable        Boolean
  attemptCount     Int
  createdAt        DateTime @default(now())

  videoAsset VideoAsset @relation(fields: [videoAssetId], references: [id], onDelete: Cascade)

