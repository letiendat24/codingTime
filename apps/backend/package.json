{
  "name": "@codesync/backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "pnpm prisma:generate && tsx watch src/server.ts",
    "build": "pnpm prisma:generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint . --max-warnings 0",
    "test": "tsx prisma/test-runner.ts",
    "test:integration": "vitest run",
    "prisma:generate": "if [ -f ../../.env ]; then set -a; . ../../.env; set +a; fi; prisma generate --schema prisma/schema.prisma",
    "db:migrate": "if [ -f ../../.env ]; then set -a; . ../../.env; set +a; fi; prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed": "tsx prisma/seed.ts",
    "seed:demo": "node --import tsx prisma/demo-seed.ts",
    "typecheck": "pnpm prisma:generate && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codesync/shared": "workspace:*",
    "@prisma/client": "^6.1.0",
    "amqplib": "^0.10.5",
    "argon2": "^0.41.1",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "minio": "^8.0.3",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "pg": "^8.13.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.6",
    "@types/express": "^4.17.21",
    "@types/express-serve-static-core": "^4.17.41",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
