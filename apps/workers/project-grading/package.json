{
  "name": "@codesync/worker-project-grading",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "if [ -f ../../../.env ]; then set -a; . ../../../.env; set +a; fi; tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "if [ -f ../../../.env ]; then set -a; . ../../../.env; set +a; fi; node dist/main.js",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@codesync/shared": "workspace:*",
    "amqplib": "^0.10.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.6",
    "@types/node": "^22.10.5",
    "vitest": "^2.1.9"
  }
}
