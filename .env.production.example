# Copy this file to .env.production and replace every secret before building production images.

CODESYNC_IMAGE_REPOSITORY=codesync
CODESYNC_IMAGE_TAG=local
CODESYNC_IMAGE_PLATFORM=linux/amd64
PUBLIC_HTTP_PORT=80
CODESYNC_RUNTIME_ENV_FILE=../../.env.production

# Application
NODE_ENV=production
API_PORT=4000
CORS_ORIGIN=http://localhost

# Database
DATABASE_URL=postgresql://codesync:replace_with_strong_database_password@postgres:5432/codesync
POSTGRES_DB=codesync
POSTGRES_USER=codesync
POSTGRES_PASSWORD=replace_with_strong_database_password

# Redis
REDIS_URL=redis://redis:6379

# RabbitMQ
RABBITMQ_URL=amqp://codesync:replace_with_strong_rabbitmq_password@rabbitmq:5672
RABBITMQ_DEFAULT_USER=codesync
RABBITMQ_DEFAULT_PASS=replace_with_strong_rabbitmq_password
RABBITMQ_MANAGEMENT_BIND=127.0.0.1
RABBITMQ_MANAGEMENT_PORT=15672

# MinIO / S3-compatible storage
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_API_BIND=127.0.0.1
MINIO_CONSOLE_BIND=127.0.0.1
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=replace_with_strong_minio_access_key
MINIO_SECRET_KEY=replace_with_strong_minio_secret_key
MINIO_BUCKET=codesync-production

# Video
VIDEO_MAX_UPLOAD_BYTES=1073741824
VIDEO_UPLOAD_URL_TTL_SECONDS=900
VIDEO_PLAYBACK_URL_TTL_SECONDS=3600
VIDEO_WORKER_CONCURRENCY=1
VIDEO_PROCESSING_MAX_ATTEMPTS=3
VIDEO_PROCESSING_TIMEOUT_SECONDS=1800
VIDEO_TEMP_ROOT=/tmp/codesync-video
VIDEO_PROGRESS_SAVE_INTERVAL_SECONDS=10
VIDEO_COMPLETION_THRESHOLD_PERCENT=90
CODE_SNAPSHOT_MAX_FILES=10
CODE_SNAPSHOT_MAX_TOTAL_BYTES=100000

# Coding Workspace
WORKSPACE_MAX_FILES=10
WORKSPACE_MAX_FILE_BYTES=100000
WORKSPACE_MAX_TOTAL_BYTES=200000
WORKSPACE_MAX_REVISIONS=10

# AI Verification
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
AI_VERIFICATION_TIMEOUT_MS=60000
AI_VERIFICATION_MAX_INPUT_BYTES=60000
AI_VERIFICATION_COOLDOWN_MS=2000

# Code Execution
CODE_EXECUTION_TIMEOUT_MS=5000
CODE_EXECUTION_MEMORY_MB=128
CODE_EXECUTION_CPU_LIMIT=0.5
CODE_EXECUTION_PIDS_LIMIT=64
CODE_EXECUTION_MAX_OUTPUT_BYTES=100000
CODE_EXECUTION_WORKER_CONCURRENCY=2
CODE_EXECUTION_MAX_ATTEMPTS=3
CODE_EXECUTION_MAX_ACTIVE_PER_USER=2
CODE_EXECUTION_RATE_LIMIT_WINDOW_MS=60000
CODE_EXECUTION_RATE_LIMIT_MAX=20
CODE_EXECUTION_TEMP_ROOT=/tmp/codesync-code-execution
DOCKER_SOCKET_PATH=/var/run/docker.sock

# Automated Judge
JUDGE_MAX_TEST_CASES=20
JUDGE_MAX_TEST_INPUT_BYTES=10000
JUDGE_MAX_EXPECTED_OUTPUT_BYTES=10000
JUDGE_MIN_TIME_LIMIT_MS=500
JUDGE_MAX_TIME_LIMIT_MS=10000
JUDGE_MIN_MEMORY_MB=32
JUDGE_MAX_MEMORY_MB=512
JUDGE_MAX_OUTPUT_BYTES=100000
JUDGE_WORKER_CONCURRENCY=2
JUDGE_MAX_ATTEMPTS=3
JUDGE_CPU_LIMIT=0.5
JUDGE_PIDS_LIMIT=64
JUDGE_TEMP_ROOT=/tmp/codesync-judge
JUDGE_MAX_ACTIVE_PER_USER=2
JUDGE_RATE_LIMIT_WINDOW_MS=60000
JUDGE_RATE_LIMIT_MAX=10

# Project Grading
PROJECT_MAX_REPOSITORY_BYTES=20000000
PROJECT_CLONE_TIMEOUT_MS=30000
PROJECT_GRADING_TIMEOUT_MS=60000
PROJECT_BUILD_TIMEOUT_MS=20000
PROJECT_TEST_TIMEOUT_MS=20000
PROJECT_MAX_OUTPUT_BYTES=100000
PROJECT_GRADING_WORKER_CONCURRENCY=1
PROJECT_GRADING_MAX_ATTEMPTS=3
PROJECT_MAX_ACTIVE_SUBMISSIONS_PER_USER=1
PROJECT_SUBMISSION_RATE_LIMIT_WINDOW_MS=60000
PROJECT_SUBMISSION_RATE_LIMIT_MAX=3
PROJECT_GRADING_CPU_LIMIT=0.5
PROJECT_GRADING_MEMORY_MB=512
PROJECT_GRADING_PIDS_LIMIT=128
PROJECT_GRADING_TEMP_ROOT=/tmp/codesync-project-grading

# Authentication
JWT_ACCESS_SECRET=replace_with_at_least_32_characters_access_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_with_at_least_32_characters_refresh_secret
JWT_REFRESH_TTL=7d
COOKIE_SECURE=true

# Frontend build-time public value. Rebuild the frontend image after changing this.
NEXT_PUBLIC_API_URL=/api/v1
