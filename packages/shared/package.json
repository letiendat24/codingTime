{
  "name": "@codesync/shared",
  "private": true,
  "version": "0.1.0",
  "description": "Shared framework-agnostic contracts for CodeSync.",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
